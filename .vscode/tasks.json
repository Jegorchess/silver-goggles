{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Server: npm install",
      "type": "shell",
      "command": "npm install --no-audit --no-fund",
      "options": { "cwd": "${workspaceFolder}/server" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Preview: запустити сервер",
      "detail": "Відкрий http://localhost:5180/preview/ у Simple Browser (Ctrl+Shift+P → Simple Browser: Show)",
      "type": "shell",
      "command": "node server.js",
      "options": { "cwd": "${workspaceFolder}/server" },
      "dependsOn": "Server: npm install",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "Server: тести",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/server" },
      "dependsOn": "Server: npm install",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Content: зібрати питання",
      "detail": "content/questions/*.json → KinoBattleApp/questions.json (з перевіркою)",
      "type": "shell",
      "command": "node tools/build-questions.js",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Content: докачати картинки",
      "type": "shell",
      "command": "node tools/fetch-media.js",
      "problemMatcher": []
    },
    {
      "label": "Engine: тести (Docker)",
      "type": "shell",
      "command": "docker run --rm -v \"${workspaceFolder}:/src\" -w /src swift:6.0 swift test --scratch-path /tmp/build",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
